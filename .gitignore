# Build products
*.o
# ...but these four are prebuilt trial-factoring objects that ship with the
# source zip, not build output. Without them the link fails.
!/linux/factor32.o
!/linux64/factor64.o
!/prime95/macosx/factor32.o
!/prime95/macosx64/factor64.o
/linux/mprime
/linux64/mprime
/macosx/mprime
/macosx64/mprime

# Stubs the makefile creates when the closed-source security module is absent
# (linux64/makefile: the "security" target touches these if missing)
/security.h
/security.c
/secure5.c

# Runtime state, if anyone runs mprime from inside the tree
/prime.txt
/local.txt
/worktodo.txt
/results.txt
/prime.log
/prime.spl

# Locally built gwnum libraries (copied/derived from gwnum/linux64/gwnum.a)
/gwnum/gwnum.a
/gwnum/polymult.a
/*/prime.txt
/*/local.txt
/*/worktodo.txt
/*/results.txt
/*/prime.log
/*/prime.spl
/*/mprime.pid
